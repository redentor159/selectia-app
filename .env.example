# =============================================================================
# SelectIA — Variables de Entorno
# =============================================================================
# Copia este archivo a `.env.local` (desarrollo) o configura en Vercel
# (Settings → Environment Variables) para producción.
#
# IMPORTANTE: NUNCA commitear `.env.local` con keys reales.
# El `.gitignore` ya excluye `.env*` excepto `.env.example`.
# Tampoco pongas keys reales en este archivo (.env.example sí se commitea).

# -----------------------------------------------------------------------------
# OBLIGATORIO en producción y desarrollo (NO hay fallback hardcodeado)
# -----------------------------------------------------------------------------
# API key de Artificial Analysis (https://artificialanalysis.ai)
# Free tier: 100 requests/día. Suficiente para el cron diario + force-refresh.
# En Vercel: Settings → Environment Variables → AA_API_KEY
# En desarrollo: copia TU key en .env.local (que está en .gitignore y NUNCA
# se commitea). No la pongas aquí en .env.example.
AA_API_KEY=tu-key-de-artificialanalysis-aqui

# -----------------------------------------------------------------------------
# OPCIONAL — mejoran funcionalidad pero la app degrada gracefully sin ellas
# -----------------------------------------------------------------------------
# Token de HuggingFace para BigCode Leaderboard (https://huggingface.co/settings/tokens)
# Sin esto, BigCode devuelve 401 y usamos la tabla estática de 23 modelos.
HF_TOKEN=tu-token-de-huggingface-aqui

# API key de metals.dev para precios de commodities (acero/cobre/aluminio)
# Sin esto, el Mapa de Proveedores usa precios fallback estáticos.
# Gratis: 100 req/mes en https://metals.dev
METALS_DEV_KEY=demo

# -----------------------------------------------------------------------------
# UPSERT OPENROUTER (feature flag — default OFF)
# -----------------------------------------------------------------------------
# Cuando esta variable es "true", el orquestador agrega al catalogo los modelos
# que OpenRouter lista pero Artificial Analysis todavia no (ej. DeepSeek V4).
# Regla de calidad: solo entran los que traen benchmarks.artificial_analysis
# (el mismo Intelligence Index de AA, copia legitima — misma escala).
# Con "false" o sin la variable, el catalogo queda solo con modelos de AA.
ENABLE_OR_UPSERT=false

# -----------------------------------------------------------------------------
# NOTIFICACIONES PUSH (ntfy.sh — gratis, sin auth)
# -----------------------------------------------------------------------------
# Canal ntfy.sh donde se envían alertas de fallos de API / cron.
# Default público: selectia-alerts
# Crea tu canal privado en https://ntfy.sh y pon el nombre aquí.
NTFY_TOPIC=selectia-alerts

# -----------------------------------------------------------------------------
# BASE DE DATOS (solo si usas Prisma — actualmente no se usa en el dashboard)
# -----------------------------------------------------------------------------
# Prisma + SQLite para desarrollo local. En producción, usar PostgreSQL si
# necesitas persistencia (no requerido para el dashboard).
DATABASE_URL=file:./db/custom.db
